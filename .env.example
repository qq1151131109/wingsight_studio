# ===== 画布主 Agent（agent/ 目录的 LangGraph 服务）=====
# OpenAI 兼容端点通吃：DeepSeek / GLM / Qwen / OpenAI 均可
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-chat
AGENT_API_KEY=
# 前端连接 agent 服务地址（默认 http://localhost:8123）
# NEXT_PUBLIC_AGENT_URL=http://localhost:8123

# ===== Langflow 技能（可选：主 Agent 的后端生成管线）=====
# langflow 后端地址
LANGFLOW_URL=http://localhost:7860
# langflow API Key（Settings → API Keys 创建；本机自动登录且未开认证时可留空）
LANGFLOW_API_KEY=
# 所有 LANGFLOW_*_FLOW_ID 不用手填：./scripts/setup-langflow.sh 首次部署时
# 自动导入 agent/flows/ 并把各 flow id 回写本文件（flow id 是导入时生成的
# UUID，每台机器不同，所以只存在于本文件、不进仓库）
# 技能表：名称 → {flowId, description}；flowId 在 langflow 画布 URL /flow/<uuid> 里
LANGFLOW_SKILLS_JSON={"宣发文案生成": {"flowId": "", "description": "输入剧本/项目信息，生成多平台宣发文案"}, "剧本转资产设定图": {"flowId": "", "description": "输入剧本，拆解资产清单并批量生成设定图"}}
# 资产拆解专用 flow id（剧本 → 资产清单 JSON）
LANGFLOW_DECOMPOSE_FLOW_ID=
# 单资产出图 flow id（资产 JSON → 设定图）
LANGFLOW_IMAGEGEN_FLOW_ID=

# 技能参数声明（示例）：params 映射到 flow 内组件字段，调用时翻译成 tweaks
# LANGFLOW_SKILLS_JSON={"技能名": {"flowId": "...", "params": {"参数": {"target": "组件id", "desc": "说明"}}}}

# ===== 文本/出图模型平台 key =====
# DMXAPI（gpt-5.6-luna / gemini / claude 系文本模型 + 出图，OpenAI 兼容）
DMX_BASE_URL=https://www.dmxapi.cn/v1
DMX_API_KEY=
# 智谱 BigModel（glm-5.3 / glm-5.3-flash；coding 网关也能代理 DeepSeek 命名模型）
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_API_KEY=
# DeepSeek 平台（留空则不启用；可指向兼容网关）
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=

# 豆包图片搜索 key（可选；未配置时出图自动走纯文生图，跳过参考图搜索）
VOLC_SEARCH_API_KEY=

# ===== 调研/原文抓取（可选）=====
# TikHub：知乎专栏正文抓取（zhuanlan.zhihu.com 登录墙）
TIKHUB_API_KEY=
# 本地 Jina Reader docker（127.0.0.1:3000）默认值可覆盖；未部署自动退回直抓
# JINA_READER_BASE_URL=
# Serper 搜索 key 不在这里：多 key 轮换号池存 SQLite，
# 入口 = /admin 管理页「Serper 号池」（serper.dev，注册送 2500 次）

# ===== 用户与认证（移植自 juben/Wingsight 主项目；默认关闭=单人零登录）=====
# false/0/no/off 关闭（匿名 admin，现有行为不变）；true 开启多人模式
AUTH_ENABLED=false
# env 管理员（开启后生效；AUTH_PASSWORD 留空时首次启动自动生成并回写这里）
AUTH_USERNAME=admin
AUTH_PASSWORD=
# JWT 签名密钥（建议显式配置，否则进程内随机、重启后 token 失效）
AUTH_TOKEN_SECRET=
# 自助注册开关（默认关；账号由管理员经 /api/v1/admin/users 创建）
AUTH_REGISTER_OPEN=false
